# Stripe test-mode API keys — see https://dashboard.stripe.com/test/apikeys
# Get STRIPE_WEBHOOK_SECRET from `stripe listen` (development) or the
# Stripe Dashboard's webhook endpoint config (production).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Run `bundle exec rake stripe:create_tax_rate` once per Stripe account
# (test mode and live mode each need their own) and paste the printed id.
STRIPE_TAX_RATE_ID=
