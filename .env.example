# Stripe test-mode API keys — see https://dashboard.stripe.com/test/apikeys
# Get STRIPE_WEBHOOK_SECRET from `stripe listen` (development) or the
# Stripe Dashboard's webhook endpoint config (production).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Run `bundle exec rake stripe:create_tax_rate` once per Stripe account
# (test mode and live mode each need their own) and paste the printed id.
STRIPE_TAX_RATE_ID=

# Tabby (BNPL) — sandbox/test keys first, from Tabby's merchant onboarding
# email or dashboard. Secret is server-side only (checkout/payments calls);
# Public is used client-side by the optional "as low as X/month" snippet.
TABBY_PUBLIC_KEY=
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
# One-time only, and only on servers with a public URL Tabby can reach:
# run `rake "tabby:create_webhook[https://<host>/tabby/webhooks]"` and
# paste the secret it prints. Verifies incoming "payment authorized"
# webhooks really came from Tabby. Left blank, TabbyWebhooksController
# rejects every webhook with 401 — harmless locally (Tabby's sandbox can't
# reach localhost anyway), but required wherever it can.
TABBY_WEBHOOK_SECRET=

# Tamara (BNPL) — sandbox/test keys first, from partners.tamara.co ->
# General settings -> API Tokens. Notification key verifies that an
# incoming "order paid" webhook really came from Tamara, not a forgery —
# required, not optional.
TAMARA_API_TOKEN=
TAMARA_PUBLIC_KEY=
TAMARA_NOTIFICATION_KEY=

# Required on staging/production only (see config/initializers/required_env_vars.rb).
# Not needed locally — development/test use the local Postgres cluster and
# don't send real email.
ZOOMORA_TOYS_DATABASE_PASSWORD=
ZOOMORA_TOYS_DATABASE_HOST=

# Production only — provider-agnostic SMTP (see config/environments/production.rb).
# Unused in local dev, which uses letter_opener instead of real SMTP.
# Three separate logins, one per real Zoho mailbox and its own purpose:
# SMTP_* (sales@) is ApplicationMailer's default — orders, admin alerts,
# contact form. SMTP_ACCOUNTS_* (accounts@) is Devise — password reset,
# unlock. SMTP_MARKETING_* (marketing@) is NewsletterMailer.
SMTP_ADDRESS=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ACCOUNTS_USERNAME=
SMTP_ACCOUNTS_PASSWORD=
SMTP_MARKETING_USERNAME=
SMTP_MARKETING_PASSWORD=

# Optional, staging/production — error tracking (see config/initializers/sentry.rb).
# Free at sentry.io: sign up, create a Rails project, paste the DSN it gives
# you. The app runs fine with this blank; errors just won't be tracked.
SENTRY_DSN=
