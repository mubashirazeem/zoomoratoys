/documents/
/docs/*

# Ignore bundler config.
/.bundle

# Ignore all environment files except the ones deliberately committed:
# .env.example (variable names only, no real values) and .env.test (dummy
# values safe for VCR cassette replay — see spec/support/vcr.rb).
/.env*
!/.env.example
!/.env.test

# Ignore all default log files and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore uploaded files in development.
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

/public/assets

# Generated sitemap — regenerate with `bin/rails sitemap:refresh:no_ping`
# after deploys or on a periodic schedule; not source, don't commit it.
/public/sitemap*.xml.gz

# Ignore master key for decrypting credentials and any other unencrypted secrets.
/config/master.key

.byebug_history

# macOS
.DS_Store

# Local tooling caches (Ruby LSP index, Playwright MCP session artifacts)
/.ruby-lsp/
/.playwright-mcp/
