      "link": "https://brakemanscanner.org/docs/warning_types/link_to_href",
      "code": "link_to(\"View on Stripe\", Order.includes(:user).find(params[:id]).stripe_dashboard_payment_intent_url, :target => \"_blank\", :rel => \"noopener\", :class => \"text-red-600\")",
      "render_path": null,
      "location": null,
      "user_input": "Order.includes(:user).find(params[:id]).stripe_dashboard_payment_intent_url",
      "confidence": "Weak",
      "note": "Explicitly acknowledged and accepted by the project owner (2026-07-20). Order#stripe_dashboard_payment_intent_url/#stripe_dashboard_invoice_url always start with the hardcoded literal \"https://dashboard.stripe.com/\" — the interpolated id can never make the result start with javascript: or any other unsafe scheme, which is what this check actually guards against. Both stripe_payment_intent_id and stripe_invoice_id are also never user-settable: they're written exclusively by Payments::WebhookHandler from a Stripe-signature-verified webhook payload (see app/services/payments/webhook_handler.rb), never from params or any form input. Re-review if stripe_dashboard_url's implementation changes."
    },
