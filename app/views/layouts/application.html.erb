<%= render "layouts/head" %>

  <body class="font-body text-body text-ink-950 bg-white antialiased" data-controller="cart-drawer">
    <div data-controller="preloader" class="zoom-preloader fixed inset-0 z-[100] flex items-center justify-center bg-ink-950 overflow-hidden" role="status" aria-label="Loading Zoomora">
      <div class="zoom-preloader__glow pointer-events-none absolute w-[520px] h-[520px] rounded-full" style="background: radial-gradient(circle, rgba(192,24,39,.30), transparent 68%); filter: blur(24px);" aria-hidden="true"></div>
      <div class="relative flex flex-col items-center px-6 text-center">
        <%= image_tag "logo-transparent.png", alt: "Zoomora", class: "zoom-preloader__logo w-[240px] lg:w-[300px] h-auto" %>
        <p class="zoom-preloader__tagline mt-5 text-[12px] lg:text-[14px] font-display font-semibold uppercase tracking-[0.35em] text-grey-300">Adventure Starts Here</p>
        <div class="mt-9 h-[3px] w-[170px] bg-white/10 overflow-hidden">
          <span class="zoom-preloader__bar-fill block h-full bg-red-600"></span>
        </div>
      </div>
    </div>

    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-sm focus:bg-ink-950 focus:px-4 focus:py-2 focus:text-white">
      Skip to content
    </a>

    <%= render Layout::SiteHeaderComponent.new(categories: @nav_categories, category_products: @nav_category_products, cart_item_count: @cart_item_count, wishlist_item_count: @wishlist_item_count, current_user: current_user) %>

    <main id="main-content">
      <% if notice.present? %>
        <div role="status" class="max-w-7xl mx-auto px-[15px] mt-6">
          <div data-controller="dismissable" class="flex items-center gap-3 rounded-[12px] border border-grey-200 bg-grey-50 px-4 py-3.5 shadow-[0_10px_30px_-20px_rgba(10,10,11,0.35)]">
            <span class="shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-ink-950/5 text-ink-950">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            </span>
            <p class="flex-1 text-body-sm font-medium text-ink-950"><%= notice %></p>
            <button type="button" data-action="dismissable#close" aria-label="Dismiss message"
              class="shrink-0 flex items-center justify-center w-7 h-7 rounded-full text-grey-500 hover:text-ink-950 hover:bg-grey-100 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-red-600">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-3.5 h-3.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
          </div>
        </div>
      <% end %>
      <% if alert.present? %>
        <div role="alert" class="max-w-7xl mx-auto px-[15px] mt-6">
          <div data-controller="dismissable" class="flex items-center gap-3 rounded-[12px] border border-red-200 bg-red-50 px-4 py-3.5 shadow-[0_10px_30px_-20px_rgba(192,24,39,0.35)]">
            <span class="shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-red-600/10 text-red-600">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M12 9v4M12 16.5h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" /></svg>
            </span>
            <p class="flex-1 text-body-sm font-medium text-red-700"><%= alert %></p>
            <button type="button" data-action="dismissable#close" aria-label="Dismiss message"
              class="shrink-0 flex items-center justify-center w-7 h-7 rounded-full text-red-400 hover:text-red-700 hover:bg-red-100 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-red-600">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-3.5 h-3.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
          </div>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <%= render Layout::SiteFooterComponent.new(categories: @nav_categories) %>

    <%= render Layout::MiniCartComponent.new(cart_items: @cart_items, subtotal_cents: @cart_subtotal_cents, suggested_products: @cart_suggested_products) %>
    <%= render Layout::WhatsappButtonComponent.new %>
  </body>
</html>
