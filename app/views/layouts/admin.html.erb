<%= render "layouts/head" %>

  <body class="font-body text-body text-ink-950 bg-grey-50 antialiased">
    <% if admin_user_signed_in? %>
      <div class="flex flex-col lg:flex-row min-h-screen">
        <%= render "admin/sidebar" %>

        <div class="flex-1 min-w-0">
          <main class="p-4 sm:p-6 lg:p-10">
            <% if notice.present? %>
              <div role="status" class="mb-6">
                <p class="rounded-[12px] bg-grey-100 border border-grey-200 px-4 py-3 text-body-sm text-ink-950"><%= notice %></p>
              </div>
            <% end %>
            <% if alert.present? %>
              <div role="alert" class="mb-6">
                <p class="rounded-[12px] bg-red-50 border border-red-200 px-4 py-3 text-body-sm text-red-700"><%= alert %></p>
              </div>
            <% end %>

            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <main class="min-h-screen flex items-center justify-center px-[15px] bg-grey-50">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
