<%# Visible controls only — associate with #coupon-apply-form /
    #coupon-remove-form (see _coupon_stub_forms.html.erb) via the HTML5
    `form=` attribute rather than wrapping in their own <form>, since this
    partial is rendered inside the checkout page's own big enclosing form. %>
<% if current_cart.persisted? && current_cart.coupon.present? %>
  <div class="flex items-center justify-between rounded-[10px] bg-red-50 border border-red-200 px-3 py-2.5">
    <span class="text-body-sm text-ink-950"><span class="font-semibold"><%= current_cart.coupon.code %></span> applied</span>
    <button type="submit" form="coupon-remove-form" class="text-body-sm font-medium text-red-600 hover:text-red-700 bg-transparent">Remove</button>
  </div>
<% else %>
  <div class="flex gap-2">
    <input type="text" name="code" form="coupon-apply-form" placeholder="Coupon code"
      class="flex-1 min-w-0 rounded-[10px] border border-grey-300 bg-grey-50 px-3 py-2.5 text-body-sm text-ink-950 placeholder:text-grey-400 focus:bg-white focus:border-red-600 focus:ring-4 focus:ring-red-600/10 focus:outline-none" />
    <button type="submit" form="coupon-apply-form" class="shrink-0 rounded-[10px] border border-grey-300 px-4 text-body-sm font-semibold text-ink-950 hover:border-red-600 hover:text-red-600 transition-colors">Apply</button>
  </div>
<% end %>
