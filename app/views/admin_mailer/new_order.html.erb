<% content_for :title, "New Order — #{@order.order_number}" %>

<h1 style="margin:0 0 16px;font-size:20px;font-weight:700;color:#0A0A0B;">New order placed</h1>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #E2E3E6;">
  <tr>
    <td style="padding:20px;font-size:13px;color:#3A3D42;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <tr><td style="padding:4px 0;color:#5B5E66;">Order</td><td align="right" style="padding:4px 0;font-weight:600;color:#0A0A0B;"><%= @order.order_number %></td></tr>
        <tr><td style="padding:4px 0;color:#5B5E66;">Customer</td><td align="right" style="padding:4px 0;color:#0A0A0B;"><%= @order.user.full_name %> (<%= @order.user.email %>)</td></tr>
        <tr><td style="padding:4px 0;color:#5B5E66;">Payment method</td><td align="right" style="padding:4px 0;color:#0A0A0B;"><%= @order.payment_method.humanize %></td></tr>
        <tr><td style="padding:4px 0;color:#5B5E66;">Total</td><td align="right" style="padding:4px 0;font-weight:700;color:#0A0A0B;"><%= format_aed(@order.total_cents) %></td></tr>
      </table>

      <div style="margin-top:12px;padding-top:12px;border-top:1px solid #E2E3E6;">
        <% @order.line_items.each do |line_item| %>
          <p style="margin:0 0 4px;">&bull; <%= line_item.product.name %> &times; <%= line_item.quantity %></p>
        <% end %>
      </div>
    </td>
  </tr>
</table>

<table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:28px;">
  <tr>
    <td style="background-color:#0A0A0B;text-align:center;">
      <a href="<%= admin_order_url(@order) %>" style="display:inline-block;padding:12px 28px;font-size:13px;font-weight:600;color:#ffffff;text-decoration:none;">View in Admin</a>
    </td>
  </tr>
</table>
