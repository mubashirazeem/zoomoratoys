<% content_for :title, "We've received your message" %>

<h1 style="margin:0 0 16px;font-size:20px;font-weight:700;color:#0A0A0B;">Hi <%= @contact_message.name %>,</h1>
<p style="margin:0 0 20px;color:#3A3D42;">Thanks for reaching out — we've received your message and our team will get back to you shortly.</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #E2E3E6;">
  <tr>
    <td style="padding:20px;font-size:13px;color:#3A3D42;">
      <p style="margin:0 0 4px;color:#5B5E66;">Subject</p>
      <p style="margin:0 0 16px;font-weight:600;color:#0A0A0B;"><%= @contact_message.subject %></p>
      <p style="margin:0 0 4px;color:#5B5E66;">Your message</p>
      <p style="margin:0;white-space:pre-wrap;"><%= @contact_message.message %></p>
    </td>
  </tr>
</table>
