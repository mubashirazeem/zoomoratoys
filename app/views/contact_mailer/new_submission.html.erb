<% content_for :title, "New contact form message" %>

<h1 style="margin:0 0 16px;font-size:20px;font-weight:700;color:#0A0A0B;">New contact form message</h1>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #E2E3E6;">
  <tr>
    <td style="padding:20px;font-size:13px;color:#3A3D42;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <tr><td style="padding:4px 0;color:#5B5E66;">Name</td><td align="right" style="padding:4px 0;color:#0A0A0B;"><%= @contact_message.name %></td></tr>
        <tr><td style="padding:4px 0;color:#5B5E66;">Email</td><td align="right" style="padding:4px 0;color:#0A0A0B;"><%= @contact_message.email %></td></tr>
        <% if @contact_message.phone.present? %>
          <tr><td style="padding:4px 0;color:#5B5E66;">Phone</td><td align="right" style="padding:4px 0;color:#0A0A0B;"><%= @contact_message.phone %></td></tr>
        <% end %>
        <tr><td style="padding:4px 0;color:#5B5E66;">Subject</td><td align="right" style="padding:4px 0;font-weight:600;color:#0A0A0B;"><%= @contact_message.subject %></td></tr>
      </table>
      <div style="margin-top:12px;padding-top:12px;border-top:1px solid #E2E3E6;white-space:pre-wrap;">
        <%= @contact_message.message %>
      </div>
    </td>
  </tr>
</table>

<p style="margin:20px 0 0;font-size:12px;color:#7E8189;">Reply to this email to respond directly to <%= @contact_message.name %>.</p>
