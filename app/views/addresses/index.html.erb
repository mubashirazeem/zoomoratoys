<% content_for :title, "Saved Addresses | Zoomora" %>

<div class="max-w-7xl mx-auto px-[15px] py-8 lg:py-10">
  <%= render Ui::BreadcrumbComponent.new(items: [
    { label: "Home", url: root_path },
    { label: "My Account", url: account_path },
    { label: "Addresses" }
  ]) %>

  <div class="mt-4 flex items-center justify-between">
    <h1 class="text-[32px] lg:text-[40px] font-display font-bold text-ink-950 leading-tight">Saved Addresses</h1>
    <%= render(Ui::ButtonComponent.new(variant: :primary, href: new_address_path)) { "Add Address" } %>
  </div>

  <% if @addresses.none? %>
    <p class="mt-8 text-body text-grey-500">You haven't saved any addresses yet.</p>
  <% else %>
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-5">
      <% @addresses.each do |address| %>
        <div class="rounded-[14px] border border-grey-200 p-5">
          <div class="flex items-center justify-between">
            <p class="font-semibold text-ink-950"><%= address.label.presence || "Address" %></p>
            <% if address.default_address? %>
              <span class="inline-flex items-center rounded-full bg-red-600/10 text-red-600 px-2.5 py-0.5 text-[12px] font-semibold">Default</span>
            <% end %>
          </div>
          <p class="mt-2 text-body-sm text-ink-950"><%= address.full_name %> · <%= address.phone %></p>
          <p class="text-body-sm text-grey-600"><%= address.summary %></p>
          <div class="mt-4 flex items-center gap-3 text-body-sm">
            <%= link_to "Edit", edit_address_path(address), class: "text-red-600 font-medium hover:text-red-700" %>
            <%= button_to "Delete", address_path(address), method: :delete,
                  form: { class: "inline-block" },
                  data: { turbo_confirm: "Delete this address?" },
                  class: "text-grey-500 font-medium hover:text-red-600 bg-transparent" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
