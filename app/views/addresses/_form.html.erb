<% field_classes = "w-full rounded-[10px] border border-grey-300 bg-grey-50 px-3.5 py-2.5 text-body-sm text-ink-950 placeholder:text-grey-400 transition focus:bg-white focus:border-red-600 focus:ring-4 focus:ring-red-600/10 focus:outline-none" %>
<% label_classes = "block text-body-sm font-medium text-ink-950 mb-1.5" %>

<%= form_with model: address, url: (address.persisted? ? address_path(address) : addresses_path), class: "flex flex-col gap-5 max-w-xl" do |f| %>
  <% if address.errors.any? %>
    <div role="alert" class="rounded-[12px] bg-red-50 border border-red-200 px-4 py-3 text-body-sm text-red-700">
      <ul class="list-disc list-inside">
        <% address.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :label, "Label (optional)", class: label_classes %>
    <%= f.text_field :label, placeholder: "Home, Work, ...", class: field_classes %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <%= f.label :full_name, "Full Name", class: label_classes %>
      <%= f.text_field :full_name, class: field_classes %>
    </div>
    <div>
      <%= f.label :phone, class: label_classes %>
      <%= f.telephone_field :phone, class: field_classes %>
    </div>
  </div>

  <div>
    <%= f.label :address_line1, "Address", class: label_classes %>
    <%= f.text_field :address_line1, class: field_classes %>
  </div>

  <div>
    <%= f.label :address_line2, "Address line 2 (optional)", class: label_classes %>
    <%= f.text_field :address_line2, class: field_classes %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <%= f.label :city, class: label_classes %>
      <%= f.text_field :city, class: field_classes %>
    </div>
    <div>
      <%= f.label :emirate, class: label_classes %>
      <%= f.select :emirate, options_for_select([ [ "Select an Emirate", "" ] ] + Order::EMIRATES, address.emirate), {}, class: field_classes %>
    </div>
  </div>

  <label class="flex items-center gap-2.5 text-body-sm text-ink-950 cursor-pointer">
    <%= f.check_box :default_address, class: "w-4 h-4 accent-red-600" %>
    Make this my default address
  </label>

  <div class="flex items-center gap-3">
    <%= render(Ui::ButtonComponent.new(variant: :primary, type: "submit")) { "Save Address" } %>
    <%= link_to "Cancel", addresses_path, class: "text-body-sm font-medium text-grey-600 hover:text-ink-950" %>
  </div>
<% end %>
