<% content_for :title, "Manage Admin | Zoomora Admin" %>

<% field_classes = "w-full rounded-[10px] border border-grey-300 bg-grey-50 px-3.5 py-2.5 text-body text-ink-950 placeholder:text-grey-400 transition focus:bg-white focus:border-red-600 focus:ring-4 focus:ring-red-600/10 focus:outline-none" %>
<% label_classes = "block text-body-sm font-medium text-ink-950 mb-1.5" %>

<h1 class="text-[24px] sm:text-[28px] font-display font-bold text-ink-950"><%= @admin_user.name %></h1>
<p class="mt-1 text-body-sm text-grey-500"><%= @admin_user.email %></p>

<div class="mt-6 rounded-[20px] border border-grey-200 bg-white p-5 sm:p-6 lg:p-8 shadow-[0_1px_2px_rgba(10,10,11,0.04)] max-w-xl">
  <%= render "devise/shared/error_messages", resource: @admin_user %>

  <%= form_with model: @admin_user, url: admin_admin_user_path(@admin_user), method: :patch, class: "flex flex-col gap-5" do |f| %>
    <div>
      <%= f.label :role, class: label_classes %>
      <%# Only Staff is ever pickable here — the sole Owner can't reach this
          form at all (see Admin::AdminUsersController#update's self-edit
          guard), and only_one_owner on the model blocks a second one
          regardless. %>
      <%= f.select :role, [ [ "Staff", "staff" ] ], {}, class: field_classes %>
      <p class="mt-1.5 text-body-sm text-grey-500">Staff can't see Coupons, Sales Reports, or Admin Users.</p>
    </div>

    <label class="flex items-center gap-2.5 text-body-sm text-ink-950 cursor-pointer">
      <%= f.check_box :active, class: "w-4 h-4 accent-red-600" %>
      Access active
    </label>
    <p class="-mt-3 text-body-sm text-grey-500">Uncheck to block their sign-in immediately, without deleting the account.</p>

    <%= render(Ui::ButtonComponent.new(variant: :primary, size: :lg, type: "submit")) { "Save Changes" } %>
  <% end %>
</div>
