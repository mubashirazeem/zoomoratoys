<% content_for :title, "Invite Admin | Zoomora Admin" %>

<% field_classes = "w-full rounded-[10px] border border-grey-300 bg-grey-50 px-3.5 py-2.5 text-body text-ink-950 placeholder:text-grey-400 transition focus:bg-white focus:border-red-600 focus:ring-4 focus:ring-red-600/10 focus:outline-none" %>
<% label_classes = "block text-body-sm font-medium text-ink-950 mb-1.5" %>

<h1 class="text-[24px] sm:text-[28px] font-display font-bold text-ink-950">Invite Admin</h1>
<p class="mt-1 text-body-sm text-grey-500">They'll get an email to set their own password — you never see or set it.</p>

<div class="mt-6 rounded-[20px] border border-grey-200 bg-white p-5 sm:p-6 lg:p-8 shadow-[0_1px_2px_rgba(10,10,11,0.04)] max-w-xl">
  <%= render "devise/shared/error_messages", resource: @admin_user %>

  <%= form_with model: @admin_user, url: admin_admin_users_path, class: "flex flex-col gap-5" do |f| %>
    <div>
      <%= f.label :name, class: label_classes %>
      <%= f.text_field :name, required: true, autofocus: true, class: field_classes %>
    </div>

    <div>
      <%= f.label :email, class: label_classes %>
      <%= f.email_field :email, required: true, class: field_classes %>
    </div>

    <div>
      <%= f.label :role, class: label_classes %>
      <%# Only Staff is ever pickable — there's exactly one Owner, enforced
          by AdminUser's own only_one_owner validation, not just by hiding
          the option here. %>
      <%= f.select :role, [ [ "Staff", "staff" ] ], { selected: "staff" }, class: field_classes %>
      <p class="mt-1.5 text-body-sm text-grey-500">Staff can't see Coupons, Sales Reports, or Admin Users.</p>
    </div>

    <%= render(Ui::ButtonComponent.new(variant: :primary, size: :lg, type: "submit")) { "Send Invitation" } %>
  <% end %>
</div>
