<% nav_item = ->(active) {
  [
    "group flex items-center gap-3 rounded-r-[10px] pr-4 py-2.5 text-body-sm border-l-2 transition-all duration-150",
    (active ? "pl-[14px] bg-white/[0.06] border-red-600 text-white font-semibold" : "pl-4 border-transparent text-grey-400 hover:bg-white/[0.04] hover:text-white hover:border-white/20 font-medium")
  ].join(" ")
} %>
<% nav_links = [
  { path: admin_root_path, label: "Dashboard", match: "dashboard",
    icon: '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>'.html_safe },
  { path: admin_products_path, label: "Products", match: "products",
    icon: '<path d="M20 7 12 3 4 7v10l8 4 8-4V7Z"/><path d="M4 7l8 4 8-4M12 11v10"/>'.html_safe },
  { path: admin_categories_path, label: "Categories", match: "categories",
    icon: '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>'.html_safe },
  { path: admin_orders_path, label: "Orders", match: "orders",
    icon: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18M16 10a4 4 0 0 1-8 0"/>'.html_safe },
  { path: admin_customers_path, label: "Customers", match: "customers",
    icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>'.html_safe },
  { path: admin_coupons_path, label: "Coupons", match: "coupons",
    icon: '<path d="M20.59 13.41 13.41 20.6a2 2 0 0 1-2.83 0L2 12.99V2h10.99l8.6 8.58a2 2 0 0 1 0 2.83Z"/><circle cx="7.5" cy="7.5" r="1.5"/>'.html_safe },
  { path: admin_blog_posts_path, label: "Blog", match: "blog_posts",
    icon: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/>'.html_safe },
  { path: admin_sales_reports_path, label: "Sales Reports", match: "sales_reports",
    icon: '<path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>'.html_safe }
] %>

<div data-controller="admin-drawer" class="lg:shrink-0">
  <%# ---- Mobile top bar (hidden lg and up) ---- %>
  <div class="lg:hidden flex items-center justify-between bg-ink-950 text-white px-4 py-3 sticky top-0 z-30">
    <%= link_to admin_root_path, class: "block" do %>
      <%= image_tag "logo-transparent.png", alt: "Zoomora", class: "h-7 w-auto" %>
    <% end %>
    <button type="button" data-action="admin-drawer#open" aria-label="Open admin menu" class="w-9 h-9 flex items-center justify-center text-white">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="w-5 h-5" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>

  <%# ---- Off-canvas backdrop + panel (mobile/tablet); static column (lg+) ---- %>
  <div data-admin-drawer-target="panel" tabindex="-1" class="hidden lg:flex fixed lg:static inset-0 z-40 lg:h-full">
    <div class="absolute lg:hidden inset-0 bg-ink-950/60" data-action="click->admin-drawer#close"></div>

    <aside class="absolute lg:static inset-y-0 left-0 w-[260px] shrink-0 bg-ink-950 text-white flex flex-col h-full lg:h-screen lg:sticky lg:top-0 overflow-y-auto lg:overflow-y-visible">
      <div class="p-6 border-b border-white/10 flex items-center justify-between">
        <div>
          <%= link_to admin_root_path, class: "block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-500" do %>
            <%= image_tag "logo-transparent.png", alt: "Zoomora", class: "h-9 w-auto" %>
          <% end %>
          <p class="mt-2 text-[11px] uppercase font-semibold tracking-[0.14em] text-grey-500">Admin Panel</p>
        </div>
        <button type="button" data-action="admin-drawer#close" aria-label="Close admin menu" class="lg:hidden w-8 h-8 flex items-center justify-center text-grey-400 hover:text-white">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="w-4 h-4" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>

      <nav class="flex-1 p-4 flex flex-col gap-1" aria-label="Admin">
        <% nav_links.each do |link| %>
          <%= link_to link[:path], class: nav_item.call(controller_name == link[:match]) do %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0" aria-hidden="true"><%= link[:icon] %></svg>
            <%= link[:label] %>
          <% end %>
        <% end %>
      </nav>

      <div class="p-4 border-t border-white/10">
        <div class="flex items-center gap-3 mb-3">
          <span class="flex items-center justify-center w-9 h-9 rounded-full bg-red-600 text-white font-display font-bold text-[13px] shrink-0"><%= current_admin_user.name.first.upcase %></span>
          <div class="min-w-0">
            <p class="text-body-sm font-medium text-white truncate"><%= current_admin_user.name %></p>
            <p class="text-[12px] text-grey-500 truncate"><%= current_admin_user.email %></p>
          </div>
        </div>
        <%= link_to destroy_admin_user_session_path, data: { turbo_method: :delete }, class: "flex items-center gap-2 text-body-sm font-semibold text-grey-400 hover:text-red-400 transition-colors" do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>
          Sign Out
        <% end %>
      </div>
    </aside>
  </div>
</div>
