<% content_for :title, "#{@customer.full_name} | Zoomora Admin" %>

<%= link_to "&larr; All Customers".html_safe, admin_customers_path, class: "text-body-sm font-medium text-grey-500 hover:text-red-600" %>

<div class="mt-4 flex items-center gap-4">
  <span class="flex items-center justify-center w-14 h-14 rounded-full bg-red-600 text-white font-display font-bold text-[20px] shrink-0"><%= @customer.first_name.first.upcase %></span>
  <div>
    <h1 class="text-[24px] sm:text-[28px] font-display font-bold text-ink-950"><%= @customer.full_name %></h1>
    <p class="mt-1 text-body-sm text-grey-500">
      <%= @customer.email %> &middot; Member since <%= @customer.created_at.strftime("%B %Y") %>
    </p>
  </div>
</div>

<div class="mt-8">
  <h2 class="text-h3 font-display text-ink-950">Order History</h2>

  <% if @orders.none? %>
    <p class="mt-3 text-body-sm text-grey-500">No orders yet.</p>
  <% else %>
    <div class="mt-4 rounded-[20px] border border-grey-200 bg-white overflow-hidden shadow-[0_1px_2px_rgba(10,10,11,0.04)] overflow-x-auto">
      <table class="w-full text-left text-body-sm">
        <thead>
          <tr class="bg-grey-50/60 border-b border-grey-200 text-[11px] uppercase font-semibold tracking-[0.08em] text-grey-500">
            <th class="px-5 py-3.5">Order</th>
            <th class="px-5 py-3.5">Date</th>
            <th class="px-5 py-3.5">Status</th>
            <th class="px-5 py-3.5 text-right">Total</th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <tr class="border-b border-grey-100 last:border-b-0 hover:bg-grey-50/60 transition-colors">
              <td class="px-5 py-4 font-mono"><%= link_to order.order_number, admin_order_path(order), class: "font-medium text-red-600 hover:text-red-700" %></td>
              <td class="px-5 py-4 text-grey-600"><%= order.placed_at.strftime("%b %-d, %Y") %></td>
              <td class="px-5 py-4">
                <%= render Admin::StatusBadgeComponent.new(label: order.status.humanize, tone: order.admin_status_tone) %>
              </td>
              <td class="px-5 py-4 text-right font-mono font-medium text-ink-950"><%= format_aed(order.total_cents) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
