<% content_for :title, "Sales Reports | Zoomora Admin" %>

<h1 class="text-[24px] sm:text-[28px] font-display font-bold text-ink-950">Sales Reports</h1>

<div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-5">
  <div class="rounded-[20px] border border-grey-200 bg-white p-6 shadow-[0_1px_2px_rgba(10,10,11,0.04)]">
    <p class="text-body-sm text-grey-500">Total Revenue</p>
    <p class="mt-1 font-mono text-[30px] sm:text-[34px] font-semibold tracking-tight text-ink-950"><%= format_aed(@total_revenue_cents) %></p>
    <p class="mt-1 text-body-sm text-grey-500">Processing, shipped, or delivered orders only.</p>
  </div>

  <div class="rounded-[20px] border border-grey-200 bg-white p-6 shadow-[0_1px_2px_rgba(10,10,11,0.04)]">
    <p class="text-body-sm text-grey-500 mb-3">Orders by Status</p>
    <% if @order_count_by_status.empty? %>
      <p class="text-body-sm text-grey-500">No orders yet.</p>
    <% else %>
      <dl class="flex flex-col gap-2">
        <% Order.statuses.each_key do |status| %>
          <div class="flex items-center justify-between text-body-sm">
            <dt class="text-grey-600"><%= status.humanize %></dt>
            <dd class="font-mono font-medium text-ink-950"><%= @order_count_by_status.fetch(status, 0) %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>
  </div>
</div>

<div class="mt-8">
  <h2 class="text-h3 font-display text-ink-950 mb-4">Top Products by Units Sold</h2>

  <% if @top_products.empty? %>
    <p class="text-body-sm text-grey-500">No sales data yet — this fills in once orders start coming through.</p>
  <% else %>
    <div class="rounded-[20px] border border-grey-200 bg-white overflow-hidden shadow-[0_1px_2px_rgba(10,10,11,0.04)] overflow-x-auto">
      <table class="w-full text-left text-body-sm">
        <thead>
          <tr class="bg-grey-50/60 border-b border-grey-200 text-[11px] uppercase font-semibold tracking-[0.08em] text-grey-500">
            <th class="px-5 py-3.5">Product</th>
            <th class="px-5 py-3.5 text-right">Units Sold</th>
          </tr>
        </thead>
        <tbody>
          <% @top_products.each do |(_product_id, name), quantity| %>
            <tr class="border-b border-grey-100 last:border-b-0 hover:bg-grey-50/60 transition-colors">
              <td class="px-5 py-4 font-medium text-ink-950"><%= name %></td>
              <td class="px-5 py-4 text-right font-mono"><%= quantity %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
