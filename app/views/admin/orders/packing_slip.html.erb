<% content_for :title, "Packing Slip #{@order.order_number} | Zoomora Admin" %>

<%= render "print_header", title: "Packing Slip", label: "Order", date_label: "Placed" %>

<div class="mt-6 grid grid-cols-2 gap-8">
  <div>
    <p class="text-[11px] uppercase font-semibold tracking-[0.08em] text-grey-500 mb-2">Ship To</p>
    <p class="text-body-sm font-medium text-ink-950"><%= @order.shipping_name %></p>
    <p class="text-body-sm text-grey-600"><%= @order.shipping_phone %></p>
    <p class="mt-1 text-body-sm text-grey-600">
      <%= @order.shipping_address_line1 %><% if @order.shipping_address_line2.present? %>, <%= @order.shipping_address_line2 %><% end %><br>
      <%= @order.shipping_city %>, <%= @order.shipping_emirate %><br>
      United Arab Emirates
    </p>
  </div>
  <div>
    <p class="text-[11px] uppercase font-semibold tracking-[0.08em] text-grey-500 mb-2">Shipment Details</p>
    <p class="text-body-sm text-grey-600">Items: <%= @line_items.sum(&:quantity) %></p>
    <% if @order.gift_wrap_cents.to_i.positive? %>
      <p class="text-body-sm text-grey-600">
        Gift wrap requested<%= " — sticker name: #{@order.gift_wrap_name}" if @order.gift_wrap_name.present? %>
      </p>
    <% end %>
    <% if @order.delivery_fee_cents.to_i.positive? %>
      <p class="text-body-sm font-semibold text-red-600">Express delivery — pack and ship first</p>
    <% end %>
  </div>
</div>

<table class="mt-8 w-full text-left text-body-sm">
  <thead>
    <tr class="border-b-2 border-ink-950 text-[11px] uppercase font-semibold tracking-[0.08em] text-grey-600">
      <th class="py-3">Item</th>
      <th class="py-3">SKU</th>
      <th class="py-3 text-right">Quantity</th>
    </tr>
  </thead>
  <tbody>
    <% @line_items.each do |line_item| %>
      <tr class="border-b border-grey-200">
        <td class="py-3.5 font-medium text-ink-950"><%= line_item.product.name %></td>
        <td class="py-3.5 font-mono text-grey-600"><%= line_item.product.sku %></td>
        <td class="py-3.5 text-right font-mono"><%= line_item.quantity %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="mt-10 pt-6 border-t border-grey-200">
  <p class="text-body-sm text-grey-500">Thank you for shopping with Zoomora — Adventure Starts Here.</p>
</div>
