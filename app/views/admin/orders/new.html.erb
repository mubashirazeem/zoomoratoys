<% content_for :title, "New Order | Zoomora Admin" %>

<% field_classes = "w-full rounded-[10px] border border-grey-300 bg-grey-50 px-3.5 py-2.5 text-body-sm text-ink-950 placeholder:text-grey-400 transition focus:bg-white focus:border-red-600 focus:ring-4 focus:ring-red-600/10 focus:outline-none" %>
<% label_classes = "block text-body-sm font-medium text-ink-950 mb-1.5" %>
<% item_row_count = 8 %>

<h1 class="text-[24px] sm:text-[28px] font-display font-bold text-ink-950">New Order</h1>
<p class="mt-1 text-body-sm text-grey-500">For phone, WhatsApp, or in-person sales that didn't go through the storefront checkout.</p>

<div class="mt-6 rounded-[20px] border border-grey-200 bg-white p-5 sm:p-6 lg:p-8 shadow-[0_1px_2px_rgba(10,10,11,0.04)] max-w-3xl">
  <% if flash[:alert].present? %>
    <div role="alert" class="mb-5 rounded-[12px] bg-red-50 border border-red-200 px-4 py-3 text-body-sm text-red-700"><%= flash[:alert] %></div>
  <% end %>

  <%= form_with url: admin_orders_path, method: :post, class: "flex flex-col gap-6" do %>
    <div>
      <%= label_tag "order_user_email", "Customer email", class: label_classes %>
      <p class="text-body-sm text-grey-500 mb-1.5">Must be an existing customer's account email — create the customer first (Customers section) if they don't have one yet.</p>
      <%= email_field_tag "order[user_email]", params.dig(:order, :user_email), required: true, class: field_classes %>
    </div>

    <div>
      <h2 class="text-body font-display font-bold text-ink-950 mb-3">Shipping Details</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <%= label_tag "order_shipping_name", "Full Name", class: label_classes %>
          <%= text_field_tag "order[shipping_name]", params.dig(:order, :shipping_name), required: true, class: field_classes %>
        </div>
        <div>
          <%= label_tag "order_shipping_phone", "Phone", class: label_classes %>
          <%= telephone_field_tag "order[shipping_phone]", params.dig(:order, :shipping_phone), required: true, class: field_classes %>
        </div>
      </div>
      <div class="mt-5">
        <%= label_tag "order_shipping_address_line1", "Address", class: label_classes %>
        <%= text_field_tag "order[shipping_address_line1]", params.dig(:order, :shipping_address_line1), required: true, class: field_classes %>
      </div>
      <div class="mt-5">
        <%= label_tag "order_shipping_address_line2", "Address line 2 (optional)", class: label_classes %>
        <%= text_field_tag "order[shipping_address_line2]", params.dig(:order, :shipping_address_line2), class: field_classes %>
      </div>
      <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <%= label_tag "order_shipping_city", "City", class: label_classes %>
          <%= text_field_tag "order[shipping_city]", params.dig(:order, :shipping_city), required: true, class: field_classes %>
        </div>
        <div>
          <%= label_tag "order_shipping_emirate", "Emirate", class: label_classes %>
          <%= select_tag "order[shipping_emirate]",
                options_for_select([ [ "Select an Emirate", "" ] ] + Order::EMIRATES, params.dig(:order, :shipping_emirate)),
                required: true, class: field_classes %>
        </div>
      </div>
    </div>

    <div>
      <h2 class="text-body font-display font-bold text-ink-950 mb-1">Items</h2>
      <p class="text-body-sm text-grey-500 mb-3">Leave unused rows blank.</p>
      <div class="flex flex-col gap-3">
        <% item_row_count.times do |i| %>
          <div class="grid grid-cols-1 sm:grid-cols-[1fr_120px] gap-3">
            <%= select_tag "order[items][#{i}][sku]",
                  options_for_select([ [ "Select a product", "" ] ] + @sku_options, params.dig(:order, :items, i.to_s, :sku)),
                  class: field_classes %>
            <%= number_field_tag "order[items][#{i}][quantity]", params.dig(:order, :items, i.to_s, :quantity), min: 0, placeholder: "Qty", class: field_classes %>
          </div>
        <% end %>
      </div>
    </div>

    <label class="flex items-center gap-2.5 text-body-sm text-ink-950 cursor-pointer">
      <%= check_box_tag "order[gift_wrap]", "1", false, class: "w-4 h-4 accent-red-600" %>
      Gift wrap
    </label>

    <div class="flex items-center gap-3">
      <%= render(Ui::ButtonComponent.new(variant: :primary, type: "submit")) { "Create Order" } %>
      <%= link_to "Cancel", admin_orders_path, class: "text-body-sm font-medium text-grey-600 hover:text-ink-950" %>
    </div>
  <% end %>
</div>
