<div class="flex items-start justify-between pb-6 border-b-2 border-ink-950">
  <div>
    <%= image_tag "logo-transparent.png", alt: "Zoomora", class: "h-10 w-auto" %>
    <p class="mt-3 text-body-sm text-grey-600">
      <%= Admin::OrdersController::INVOICE_ACCOUNTS_EMAIL %><br>
      <%= Admin::OrdersController::INVOICE_SALES_EMAIL %><br>
      <%= Admin::OrdersController::INVOICE_MOBILE %><br>
      Dubai, United Arab Emirates
    </p>
  </div>
  <div class="text-right">
    <h1 class="text-[22px] font-display font-bold text-ink-950 uppercase tracking-[0.04em]"><%= title %></h1>
    <p class="mt-2 text-body-sm text-grey-600"><%= label %> <span class="font-mono font-semibold text-ink-950"><%= @order.order_number %></span></p>
    <p class="text-body-sm text-grey-600"><%= date_label %> <%= @order.placed_at.strftime("%B %-d, %Y") %></p>
  </div>
</div>
