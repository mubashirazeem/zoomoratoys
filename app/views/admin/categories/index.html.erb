<% content_for :title, "Categories | Zoomora Admin" %>

<%= render Admin::PageHeaderComponent.new(title: "Categories") do |header| %>
  <% header.with_action { render(Ui::ButtonComponent.new(variant: :primary, href: new_admin_category_path)) { "New Category" } } %>
<% end %>

<% if @categories.none? %>
  <p class="mt-8 text-body-sm text-grey-500">No categories yet.</p>
<% else %>
  <div class="mt-8 rounded-[20px] border border-grey-200 bg-white overflow-hidden shadow-[0_1px_2px_rgba(10,10,11,0.04)] overflow-x-auto">
    <table class="w-full text-left text-body-sm">
      <thead>
        <tr class="bg-grey-50/60 border-b border-grey-200 text-[11px] uppercase font-semibold tracking-[0.08em] text-grey-500">
          <th class="px-5 py-3.5">Name</th>
          <th class="px-5 py-3.5">Slug</th>
          <th class="px-5 py-3.5">Products</th>
          <th class="px-5 py-3.5">Nav Order</th>
          <th class="px-5 py-3.5"></th>
        </tr>
      </thead>
      <tbody>
        <% @categories.each do |category| %>
          <tr class="border-b border-grey-100 last:border-b-0 hover:bg-grey-50/60 transition-colors">
            <td class="px-5 py-4 font-medium text-ink-950"><%= category.name %></td>
            <td class="px-5 py-4 text-grey-500"><%= category.slug %></td>
            <td class="px-5 py-3.5"><%= category.products.size %></td>
            <td class="px-5 py-3.5"><%= category.position %></td>
            <td class="px-5 py-4 text-right whitespace-nowrap">
              <%= link_to "Edit", edit_admin_category_path(category), class: "text-red-600 font-medium hover:text-red-700" %>
              <%= button_to "Delete", admin_category_path(category), method: :delete,
                    form: { class: "inline-block ml-3" },
                    data: { turbo_confirm: "Delete #{category.name}? This only works if it has no products." },
                    class: "text-grey-500 font-medium hover:text-red-600 bg-transparent" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
