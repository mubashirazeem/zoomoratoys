<% content_for :title, "#{@product.name} — Variants | Zoomora Admin" %>

<%= link_to "← Back to Products", admin_products_path, class: "text-body-sm font-medium text-grey-600 hover:text-ink-950" %>

<div class="mt-3 flex items-center justify-between">
  <h1 class="text-[28px] font-display font-bold text-ink-950">Variants — <%= @product.name %></h1>
  <%= render(Ui::ButtonComponent.new(variant: :primary, href: new_admin_product_variant_path(@product))) { "New Variant" } %>
</div>

<% if @variants.none? %>
  <p class="mt-6 text-body-sm text-grey-500">
    No variants yet — the shop page shows no Color/Size/Material selector until at least one is added here.
  </p>
<% else %>
  <div class="mt-6 rounded-[20px] border border-grey-200 bg-white overflow-hidden shadow-[0_1px_2px_rgba(10,10,11,0.04)] overflow-x-auto">
    <table class="w-full text-left text-body-sm">
      <thead>
        <tr class="bg-grey-50/60 border-b border-grey-200 text-[11px] uppercase font-semibold tracking-[0.08em] text-grey-500">
          <th class="px-5 py-3.5">Options</th>
          <th class="px-5 py-3.5">SKU</th>
          <th class="px-5 py-3.5">Price</th>
          <th class="px-5 py-3.5">Stock</th>
          <th class="px-5 py-3.5"></th>
        </tr>
      </thead>
      <tbody>
        <% @variants.each do |variant| %>
          <tr class="border-b border-grey-100 last:border-b-0 hover:bg-grey-50/60 transition-colors">
            <td class="px-5 py-4 font-medium text-ink-950"><%= variant.option_summary %></td>
            <td class="px-5 py-4 text-grey-500"><%= variant.sku %></td>
            <td class="px-5 py-3.5"><%= variant.price_cents ? format_aed(variant.price_cents) : "Same as product" %></td>
            <td class="px-5 py-3.5"><%= variant.stock_quantity %></td>
            <td class="px-5 py-4 text-right whitespace-nowrap">
              <%= link_to "Edit", edit_admin_product_variant_path(@product, variant), class: "text-red-600 font-medium hover:text-red-700" %>
              <%= button_to "Delete", admin_product_variant_path(@product, variant), method: :delete,
                    form: { class: "inline-block ml-3" },
                    data: { turbo_confirm: "Delete this variant?" },
                    class: "text-grey-500 font-medium hover:text-red-600 bg-transparent" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
