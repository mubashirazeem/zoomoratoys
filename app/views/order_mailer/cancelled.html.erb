<% content_for :title, "Order Cancelled — #{@order.order_number}" %>

<h1 style="margin:0 0 16px;font-size:20px;font-weight:700;color:#0A0A0B;">Hi <%= @order.user.first_name %>,</h1>
<p style="margin:0 0 24px;color:#3A3D42;">Your order <strong style="color:#0A0A0B;"><%= @order.order_number %></strong> has been cancelled.</p>

<% if @order.card? && @order.stripe_payment_status == :paid %>
  <p style="margin:0 0 24px;color:#3A3D42;">If you were charged for this order, our team will follow up separately about a refund.</p>
<% end %>

<p style="margin:0 0 24px;color:#5B5E66;font-size:13px;">If you believe this was a mistake, please contact us and we'll be happy to help.</p>

<table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:8px;">
  <tr>
    <td style="background-color:#0A0A0B;text-align:center;">
      <a href="mailto:sales@zoomora.com" style="display:inline-block;padding:12px 28px;font-size:13px;font-weight:600;color:#ffffff;text-decoration:none;">Contact Us</a>
    </td>
  </tr>
</table>
