<% content_for :title, "Unlock your account" %>

<h1 style="margin:0 0 16px;font-size:20px;font-weight:700;color:#0A0A0B;">Your account was locked</h1>
<p style="margin:0 0 24px;color:#3A3D42;">The account for <%= @resource.email %> was locked due to an excessive number of unsuccessful sign-in attempts.</p>

<table role="presentation" cellpadding="0" cellspacing="0">
  <tr>
    <td style="background-color:#C01827;text-align:center;">
      <%= link_to "Unlock My Account", unlock_url(@resource, unlock_token: @token), style: "display:inline-block;padding:12px 28px;font-size:13px;font-weight:600;color:#ffffff;text-decoration:none;" %>
    </td>
  </tr>
</table>
