<% content_for :title, "Order Confirmed | Zoomora" %>

<div class="max-w-3xl mx-auto px-[15px] py-16 text-center">
  <% if @order.awaiting_payment? %>
    <meta http-equiv="refresh" content="3">
    <span class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-grey-100 text-grey-500 mb-6">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
    </span>
    <h1 class="text-[28px] lg:text-[36px] font-display font-bold text-ink-950 leading-tight">Confirming your payment&hellip;</h1>
    <p class="mt-3 text-body-lg text-grey-600">This only takes a moment. This page will update automatically.</p>
    <p class="mt-1 text-body text-grey-500">Order number: <span class="font-semibold text-ink-950"><%= @order.order_number %></span></p>
  <% else %>
    <span class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-red-600/10 text-red-600 mb-6">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
    </span>

    <h1 class="text-[28px] lg:text-[36px] font-display font-bold text-ink-950 leading-tight">Thank you, <%= @order.user.first_name %>!</h1>
    <p class="mt-3 text-body-lg text-grey-600"><%= @order.pay_on_delivery? ? "Your order has been placed and will be paid on delivery." : "Your payment was successful and your order has been placed." %></p>
    <p class="mt-1 text-body text-grey-500">Order number: <span class="font-semibold text-ink-950"><%= @order.order_number %></span></p>

  <div class="mt-10 text-left rounded-[18px] border border-grey-200 bg-white p-6">
    <ul class="flex flex-col gap-4 divide-y divide-grey-200">
      <% @order.line_items.each do |line_item| %>
        <li class="flex items-center justify-between gap-3 pt-4 first:pt-0">
          <div class="min-w-0">
            <p class="text-body-sm font-medium text-ink-950 line-clamp-2"><%= line_item.product.name %></p>
            <p class="text-[12px] text-grey-500">Qty <%= line_item.quantity %></p>
          </div>
          <span class="text-body-sm font-semibold text-ink-950 shrink-0"><%= format_aed(line_item.price_cents * line_item.quantity) %></span>
        </li>
      <% end %>
    </ul>

    <div class="border-t border-grey-200 mt-4 pt-4 flex flex-col gap-2 text-body-sm">
      <div class="flex justify-between">
        <span class="text-grey-600">Subtotal</span>
        <span class="font-medium text-ink-950"><%= format_aed(@order.subtotal_cents) %></span>
      </div>
      <% if @order.gift_wrap_cents.positive? %>
        <div class="flex justify-between">
          <span class="text-grey-600">Gift wrap</span>
          <span class="font-medium text-ink-950"><%= format_aed(@order.gift_wrap_cents) %></span>
        </div>
      <% end %>
      <div class="flex justify-between font-display font-bold text-ink-950 text-[16px] pt-2">
        <span>Total</span>
        <span><%= format_aed(@order.total_cents) %></span>
      </div>
      <p class="text-[12px] text-grey-500 text-right"><%= vat_inclusive_note(@order.total_cents) %></p>
    </div>

    <div class="border-t border-grey-200 mt-4 pt-4 text-body-sm text-grey-600">
      <p class="font-medium text-ink-950">Shipping to:</p>
      <p><%= @order.shipping_name %> · <%= @order.shipping_phone %></p>
      <p><%= @order.shipping_address_line1 %><%= ", #{@order.shipping_address_line2}" if @order.shipping_address_line2.present? %></p>
      <p><%= @order.shipping_city %>, <%= @order.shipping_emirate %></p>
    </div>
  </div>

  <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
    <%= render(Ui::ButtonComponent.new(variant: :primary, size: :lg, href: account_orders_path)) { "View Order History" } %>
    <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :lg, href: products_path)) { "Continue Shopping" } %>
  </div>
  <% end %>
</div>
