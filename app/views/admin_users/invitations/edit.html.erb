<% content_for :title, "Set Your Password | Zoomora Admin" %>

<% field_classes = "w-full rounded-[12px] border border-grey-300 bg-grey-50 px-4 py-3 text-body text-ink-950 placeholder:text-grey-400 transition focus:bg-white focus:border-red-600 focus:ring-4 focus:ring-red-600/10 focus:outline-none" %>
<% label_classes = "block text-body-sm font-medium text-ink-950 mb-1.5" %>

<div class="w-full max-w-sm">
  <div class="text-center">
    <%= image_tag "logo-transparent.png", alt: "Zoomora", class: "h-12 w-auto mx-auto" %>
    <p class="mt-4 text-[12px] uppercase font-semibold tracking-[0.16em] text-red-600">Admin Panel</p>
    <h1 class="mt-2 text-[26px] font-display font-bold text-ink-950">Welcome, <%= resource.name %></h1>
    <p class="mt-2 text-body-sm text-grey-600">Set a password to finish setting up your admin access.</p>
  </div>

  <div class="mt-8 rounded-[18px] border border-grey-200 bg-white p-6 lg:p-8 shadow-[0_10px_30px_-24px_rgba(10,10,11,0.4)]">
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: invitation_path(resource_name), html: { method: :put, class: "flex flex-col gap-5" }) do |f| %>
      <%= f.hidden_field :invitation_token %>

      <div>
        <%= f.label :password, "Password", class: label_classes %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: field_classes %>
        <% if @minimum_password_length %>
          <p class="mt-1.5 text-body-sm text-grey-500"><%= @minimum_password_length %> characters minimum</p>
        <% end %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm Password", class: label_classes %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: field_classes %>
      </div>

      <%= render(Ui::ButtonComponent.new(variant: :primary, size: :lg, full_width: true, type: "submit")) { "Set Password & Sign In" } %>
    <% end %>
  </div>
</div>
