<div
  data-nav-drawer-target="panel"
  class="hidden fixed inset-0 z-50 lg:hidden"
  tabindex="-1"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
>
  <div class="absolute inset-0 bg-ink-950/50" data-action="click->nav-drawer#close"></div>

  <div class="absolute inset-y-0 right-0 w-full max-w-xs bg-white shadow-elevated flex flex-col">
    <div class="flex items-center justify-between h-16 px-4 border-b border-grey-200">
      <p class="font-display font-semibold text-h3 text-ink-950">Menu</p>
      <button
        type="button"
        data-action="nav-drawer#close"
        aria-label="Close menu"
        class="flex items-center justify-center w-10 h-10 rounded-md text-ink-950 hover:bg-grey-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-red-600"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="w-6 h-6" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <nav aria-label="Primary" class="flex-1 min-h-0 overflow-y-auto flex flex-col p-4 gap-1">
      <% items.each do |item| %>
        <%= link_to item[:label], item[:url], class: "px-3 py-3 rounded-md text-body font-display font-semibold text-ink-950 hover:bg-grey-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-red-600" %>
      <% end %>
    </nav>

    <div class="shrink-0 border-t border-grey-200 p-4 flex flex-col gap-1">
      <% if signed_in? %>
        <%= link_to account_path, class: "flex items-center gap-3 px-3 py-3 rounded-md text-body font-display font-semibold text-ink-950 hover:bg-grey-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-red-600" do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 shrink-0" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-3.3 3.6-6 8-6s8 2.7 8 6"/></svg>
          <span>My Account</span>
        <% end %>
        <%= link_to "Sign Out", destroy_user_session_path, data: { turbo_method: :delete }, class: "px-3 py-3 rounded-md text-body font-display font-semibold text-ink-950 hover:bg-grey-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-red-600" %>
      <% else %>
        <%= link_to new_user_session_path, class: "flex items-center gap-3 px-3 py-3 rounded-md text-body font-display font-semibold text-ink-950 hover:bg-grey-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-red-600" do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 shrink-0" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-3.3 3.6-6 8-6s8 2.7 8 6"/></svg>
          <span>Sign In</span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
