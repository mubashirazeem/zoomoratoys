<%= content_tag(href ? :a : :div, href: href, class: "group relative flex flex-col gap-4 rounded-[18px] border border-grey-200 bg-white p-6 transition-all duration-200 #{"hover:border-red-600/40 hover:shadow-[0_16px_40px_-24px_rgba(10,10,11,0.35)] hover:-translate-y-0.5" if href}") do %>
  <span class="flex items-center justify-center w-11 h-11 rounded-[12px] <%= accent_classes %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><%= icon_markup %></svg>
  </span>
  <div>
    <p class="font-mono text-[34px] leading-none font-semibold tracking-tight <%= value_classes %>"><%= value %></p>
    <p class="mt-2 text-body-sm text-grey-500"><%= label %></p>
  </div>
<% end %>
