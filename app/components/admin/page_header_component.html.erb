<div class="flex items-center justify-between gap-4 flex-wrap">
  <div>
    <h1 class="text-[24px] sm:text-[28px] font-display font-bold text-ink-950"><%= title %></h1>
    <% if subtitle.present? %>
      <p class="mt-1 text-body-sm text-grey-500"><%= subtitle %></p>
    <% end %>
  </div>
  <% if action? %>
    <div class="shrink-0"><%= action %></div>
  <% end %>
</div>
