<%= tag.section class: wrapper_classes, data: wrapper_data do %>
  <% if photos.any? %>
    <div class="absolute inset-0 overflow-hidden">
      <div class="promo-banner-track flex h-full" data-promo-banner-slideshow-target="track">
        <% photos.each_with_index do |photo, i| %>
          <div class="promo-banner-slide <%= "is-active" if i.zero? %> shrink-0 w-full h-full" data-promo-banner-slideshow-target="slide" aria-hidden="<%= i.zero? ? "false" : "true" %>">
            <%= image_tag photo, alt: "", class: "w-full h-full object-cover" %>
          </div>
        <% end %>
      </div>
    </div>
    <div class="absolute inset-0 bg-ink-950/70" aria-hidden="true"></div>
  <% end %>

  <div class="relative">
    <h2 class="text-h1 font-display uppercase <%= tone[:title] %> text-balance"><%= title %></h2>
    <% if description.present? %>
      <p class="mt-4 text-body-lg <%= tone[:body] %> max-w-xl mx-auto"><%= description %></p>
    <% end %>
    <div class="mt-8">
      <%= render(Ui::ButtonComponent.new(variant: tone[:button], size: :lg, href: cta_url, class_name: "uppercase tracking-[0.04em]")) { cta_label } %>
    </div>
  </div>

  <% if photos.size > 1 %>
    <button type="button" data-action="promo-banner-slideshow#prev" aria-label="Previous photo"
      class="rail-arrow absolute left-3 lg:left-5 top-1/2 -translate-y-1/2 z-10 w-9 h-9 lg:w-11 lg:h-11 flex items-center justify-center">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <button type="button" data-action="promo-banner-slideshow#next" aria-label="Next photo"
      class="rail-arrow absolute right-3 lg:right-5 top-1/2 -translate-y-1/2 z-10 w-9 h-9 lg:w-11 lg:h-11 flex items-center justify-center">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
    </button>

    <div class="absolute inset-x-0 bottom-5 flex items-center justify-center gap-2 z-10">
      <% photos.each_index do |i| %>
        <button type="button" class="promo-banner-dot" data-promo-banner-slideshow-target="dot"
          data-action="promo-banner-slideshow#goto" data-index="<%= i %>"
          aria-current="<%= i.zero? ? "true" : "false" %>" aria-label="Show photo <%= i + 1 %>"></button>
      <% end %>
    </div>
  <% end %>
<% end %>
