<div class="flex flex-col gap-5">
  <% option_types.each do |option_type| %>
    <div>
      <p class="text-body-sm text-ink-950 mb-2.5">
        <span class="font-semibold"><%= option_type %>:</span>
        <span data-product-variant-picker-target="label" data-option-type="<%= option_type %>"><%= default_variant.options[option_type] %></span>
      </p>
      <div class="flex items-center gap-2 flex-wrap">
        <% option_values(option_type).each do |value| %>
          <% selected = default_variant.options[option_type] == value %>
          <button type="button"
            data-product-variant-picker-target="option"
            data-action="product-variant-picker#select"
            data-option-type="<%= option_type %>"
            data-option-value="<%= value %>"
            aria-pressed="<%= selected %>"
            class="px-4 h-10 rounded-full border-2 text-body-sm font-medium <%= selected ? "border-red-600 text-red-600" : "border-grey-200 text-ink-950" %> hover:border-red-600 hover:text-red-600 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600">
            <%= value %>
          </button>
        <% end %>
      </div>
    </div>
  <% end %>

  <p data-product-variant-picker-target="unavailable" hidden class="text-body-sm font-medium text-red-600">
    This combination isn't available.
  </p>
  <p class="text-body-sm text-grey-600">
    <span data-product-variant-picker-target="priceSummary" class="font-semibold text-ink-950"><%= helpers.format_aed(default_variant.effective_price_cents) %></span>
    · SKU: <span data-product-variant-picker-target="sku"><%= default_variant.sku %></span>
    <span data-product-variant-picker-target="stockNotice" class="text-red-600 font-medium ml-1"><%= default_variant.in_stock? ? "" : "Out of stock" %></span>
  </p>

  <%= hidden_field_tag "product_variant_id", default_variant.id, data: { "product-variant-picker-target": "variantIdField" } %>
</div>
